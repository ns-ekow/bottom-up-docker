#!/usr/bin/env -S python3 -I
"""Find technical terms a reader may not know, and terms the glossary already covers.

  jargon-scan <file.mdx> [...]       candidates in these lessons/pages
  jargon-scan --all                  every lesson, guide page and the curriculum text
  jargon-scan --alias "exec"         where a (proposed) glossary alias would match, with context

This lists *candidates*; deciding which ones the target reader would trip on is a judgement call.
For each real one: add a glossary entry, or explain it in the sentence where it first appears.
Candidates come from: inline code spans, man-page references like unshare(2), ALL-CAPS tokens,
and a seed list of common technical words (jargon-words.txt). Code blocks, front matter, imports,
comments and component attributes are ignored.
"""
import re, sys, tomllib
from pathlib import Path

HERE = Path(__file__).resolve().parent
REPO = HERE.parents[3]
DOCS = REPO / "site" / "src" / "content" / "docs"

def load_glossary():
    g = tomllib.loads((REPO / "glossary.toml").read_text())
    return g["term"]

def strict(a): return a.upper() == a and any(c.isalpha() for c in a)

def alias_re(a):
    return re.compile(r"(?<![\w-])" + re.escape(a) + r"(?![\w-])", 0 if strict(a) else re.I)

def prose(text):
    """MDX -> the prose a reader sees, keeping line numbers (removed spans become spaces)."""
    blank = lambda m: re.sub(r"[^\n]", " ", m.group())
    text = re.sub(r"\A---\n.*?\n---\n", blank, text, flags=re.S)        # front matter
    text = re.sub(r"^```.*?^```", blank, text, flags=re.S | re.M)        # code blocks
    text = re.sub(r"\{/\*.*?\*/\}", blank, text, flags=re.S)             # MDX comments
    text = re.sub(r"^import .*$", blank, text, flags=re.M)               # imports
    text = re.sub(r"<[A-Z][\w.]*\b[^>]*?/?>|</[A-Z][\w.]*>", blank, text, flags=re.S)  # component tags
    return text

def line_of(text, pos): return text.count("\n", 0, pos) + 1

def sources(args):
    if args == ["--all"]:
        files = sorted(DOCS.rglob("*.md*"))
        return [(f.relative_to(REPO), prose(f.read_text())) for f in files] + [curriculum_text()]
    return [(Path(a), prose(Path(a).read_text())) for a in args]

def curriculum_text():
    cur = tomllib.loads((REPO / "curriculum.toml").read_text())
    lines = []
    for m in cur["module"]:
        for k in ("title", "question", "experiment", "build", "trace"):
            lines.append(f"[{m['id']} {k}] {m[k]}")
        lines += [f"[{m['id']} objective] {o}" for o in m["objectives"]]
    return (Path("curriculum.toml"), "\n".join(lines))

def scan(files):
    terms = load_glossary()
    aliases = [(a, t["id"]) for t in terms for a in t["aliases"]]
    alias_exact = {a if strict(a) else a.lower(): tid for a, tid in aliases}
    seed = [w.strip() for w in (HERE / "jargon-words.txt").read_text().splitlines()
            if w.strip() and not w.startswith("#")]

    def covered(word):
        key = word if strict(word) else word.lower()
        if key in alias_exact: return True
        return any(alias_re(a).fullmatch(word) for a, _ in aliases)

    for path, text in files:
        found = {}  # term -> [kind, count, first_line]
        def add(term, kind, pos):
            if covered(term): return
            e = found.setdefault(term, [kind, 0, line_of(text, pos)]); e[1] += 1
        codes = list(re.finditer(r"`([^`\n]+)`", text))
        for m in codes:
            add(m.group(1), "code", m.start())
        plain = re.sub(r"`[^`\n]+`", lambda m: " " * len(m.group()), text)
        for m in re.finditer(r"\b([a-z_][a-z0-9_]*)\((\d)\)", plain):
            add(m.group(0), "man page", m.start())
        for m in re.finditer(r"(?<![\w/.-])([A-Z][A-Z0-9_]{1,})(?![\w-])", plain):
            add(m.group(1), "acronym", m.start())
        for w in seed:
            for m in alias_re(w).finditer(plain):
                add(m.group(0) if strict(w) else w, "jargon", m.start())
        hits = {t["term"]: sum(len(alias_re(a).findall(plain)) for a in t["aliases"]) for t in terms}
        used = sorted((k for k, v in hits.items() if v), key=str.lower)

        print(f"== {path}")
        print(f"   glossary terms used here ({len(used)}): {', '.join(used) or '-'}")
        if not found:
            print("   no undefined candidates"); continue
        print(f"   undefined candidates ({len(found)}): decide for each: glossary entry, inline explanation, or fine as is")
        for term, (kind, n, line) in sorted(found.items(), key=lambda x: (x[1][2], x[0].lower())):
            print(f"   {path}:{line:<5} {kind:<9} {term}" + (f"  (x{n})" if n > 1 else ""))

def alias_mode(alias):
    rx = alias_re(alias)
    owner = [t["id"] for t in load_glossary() if alias.lower() in (a.lower() for a in t["aliases"])]
    print(f"alias {alias!r}: {'already belongs to ' + owner[0] if owner else 'not in the glossary yet'}; "
          f"matching is {'case-sensitive' if strict(alias) else 'case-insensitive'}")
    n = 0
    for path, text in sources(["--all"]):
        plain = text
        for i, line in enumerate(plain.splitlines(), 1):
            for m in rx.finditer(line):
                n += 1
                s = max(0, m.start() - 50)
                print(f"  {path}:{i}: …{line[s:m.end() + 50].strip()}…")
    print(f"{n} occurrence(s). Check each one means this term; if any means something else, narrow the alias.")

def main():
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help"): print(__doc__); return 2
    if a[0] == "--alias":
        if len(a) != 2: print("usage: jargon-scan --alias \"word\""); return 2
        alias_mode(a[1]); return 0
    scan(sources(a)); return 0

if __name__ == "__main__":
    sys.exit(main())
