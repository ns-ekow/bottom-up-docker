#!/usr/bin/env bash
# bottom-up-docker one-command setup for a Linux x86_64 host.
#
#   ./setup              check everything, fix what can be fixed (asks before every sudo), build it all
#   ./setup --check      report only: change nothing
#   ./setup --yes        don't ask before sudo commands
#   ./setup --reset-vm   rebuild the lab VM even if it exists and verifies
#
# Safe to re-run: every step skips work that is already done.
# Steps: preflight -> KVM -> host packages -> Lima -> source -> VM -> corpus -> index -> site -> self-test
set -uo pipefail
cd "$(dirname "$0")"
REPO=$(pwd)
source vm/versions.env

CHECK=0 YES=0 RESET_VM=0
for a in "$@"; do case $a in
  --check) CHECK=1 ;; --yes) YES=1 ;; --reset-vm) RESET_VM=1 ;;
  -h|--help) sed -n '2,10p' "$0"; exit 0 ;;
  *) echo "unknown option: $a" >&2; exit 2 ;;
esac; done

# Test hooks (let the KVM logic be exercised on a machine that has KVM). Not for normal use.
CPUINFO=${BUD_CPUINFO:-/proc/cpuinfo}
KVM_DEV=${BUD_KVM_DEV:-/dev/kvm}

# ------------------------------------------------------------------ output helpers
if [ -t 1 ]; then B=$'\e[1m' G=$'\e[32m' Y=$'\e[33m' R=$'\e[31m' N=$'\e[0m'; else B= G= Y= R= N=; fi
step()  { echo; echo "${B}==> $*${N}"; }
ok()    { echo "  ${G}ok${N}    $*"; }
warn()  { echo "  ${Y}warn${N}  $*"; WARNINGS+=("$*"); }
fail()  { echo "  ${R}FAIL${N}  $*"; }
todo()  { echo "  ${Y}todo${N}  $*"; PENDING=1; }
die()   { echo; echo "${R}setup stopped:${N} $*" >&2; exit 1; }
WARNINGS=() PENDING=0

# Run a command as root, after showing it and (unless --yes) asking.
as_root() { # description, command...
  local desc=$1; shift
  if [ $CHECK -eq 1 ]; then todo "$desc:  sudo $*"; return 1; fi
  echo "  ${Y}sudo${N}  $desc"
  echo "        sudo $*"
  if [ $YES -eq 0 ]; then
    read -r -p "        run it? [y/N] " r </dev/tty || r=n
    [[ $r =~ ^[Yy]$ ]] || { fail "skipped by you"; return 1; }
  fi
  sudo "$@"
}

vercmp_ge() { # a >= b (dotted versions)
  [ "$(printf '%s\n%s\n' "$2" "$1" | sort -V | head -1)" = "$2" ]
}

# ------------------------------------------------------------------ 1. preflight
step "Preflight"
[ "$(uname -s)" = Linux ] || die "this setup targets Linux hosts (found $(uname -s))"
[ "$(uname -m)" = x86_64 ] || die "the lab VM is pinned to x86_64 (found $(uname -m)); an ARM variant is not built yet"
ok "Linux x86_64 ($(. /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-unknown distro}"))"

mem_gib=$(awk '/MemTotal/ {printf "%.1f", $2/1048576}' /proc/meminfo)
if awk "BEGIN{exit !($mem_gib >= 6)}"; then ok "RAM ${mem_gib} GiB (VM uses 3 GiB)"
else warn "RAM ${mem_gib} GiB: the VM takes 3 GiB; expect a slow host while it runs"; fi

free_gib=$(df -BG --output=avail "$HOME" | tail -1 | tr -dc 0-9)
vm_exists=$(command -v limactl >/dev/null && limactl list -q 2>/dev/null | grep -qx bud && echo 1 || echo 0)
if [ "$free_gib" -ge 15 ]; then ok "disk ${free_gib} GiB free (need ~15 GiB: VM ~5, source ~1, site ~0.5, image cache)"
elif [ "$vm_exists" = 1 ] && [ $RESET_VM -eq 0 ]; then warn "disk ${free_gib} GiB free; fine while the existing VM is kept"
else die "only ${free_gib} GiB free in $HOME; need ~15 GiB to build the VM"; fi

if command -v python3 >/dev/null && vercmp_ge "$(python3 -c 'import sys;print("%d.%d"%sys.version_info[:2])')" "$PYTHON_MIN"; then
  ok "python $(python3 -V | cut -d' ' -f2)"
else die "python3 >= $PYTHON_MIN required (for tomllib)"; fi
if command -v node >/dev/null && vercmp_ge "$(node -v | tr -d v)" "$NODE_MIN"; then
  ok "node $(node -v)"
else
  die "node >= $NODE_MIN required for the site (found: $(node -v 2>/dev/null || echo none)).
  Install it without sudo via nvm: https://github.com/nvm-sh/nvm  then: nvm install 22"
fi

# ------------------------------------------------------------------ 2. KVM
step "Hardware virtualization (KVM)"
if grep -qE '\b(vmx|svm)\b' "$CPUINFO"; then
  vendor=$(grep -qw vmx "$CPUINFO" && echo intel || echo amd)
  ok "CPU supports virtualization ($( [ $vendor = intel ] && echo 'Intel VT-x' || echo 'AMD-V'))"
else
  # prints "none" AND exits non-zero on bare metal, so don't append a fallback; default only if empty
  virt=$(systemd-detect-virt --vm 2>/dev/null || true); virt=${virt:-none}
  if [ "$virt" != none ]; then
    die "this machine is itself a VM ($virt) and does not expose virtualization to its guests.
  Enable NESTED virtualization in the outer hypervisor, then re-run ./setup.
  (VirtualBox: Settings > System > Processor > Enable Nested VT-x/AMD-V;
   KVM host: options kvm_intel nested=1 / kvm_amd nested=1; Hyper-V: Set-VMProcessor -ExposeVirtualizationExtensions \$true)"
  else
    die "the CPU reports no virtualization support (no vmx/svm flag).
  It is almost certainly DISABLED in firmware: reboot into BIOS/UEFI setup and enable
  'Intel Virtualization Technology (VT-x)' or 'SVM Mode' (AMD), then re-run ./setup.
  Software cannot change this setting."
  fi
fi

if [ -e "$KVM_DEV" ]; then
  ok "$KVM_DEV exists (kvm module loaded)"
else
  mod=kvm_$vendor
  if as_root "load the $mod kernel module" modprobe "$mod" && [ -e "$KVM_DEV" ]; then
    ok "$mod loaded"
    as_root "load $mod at every boot" sh -c "echo $mod > /etc/modules-load.d/bud-kvm.conf" && ok "persisted in /etc/modules-load.d/bud-kvm.conf"
  elif [ $CHECK -eq 0 ]; then
    die "$KVM_DEV still missing after loading $mod. Check: sudo dmesg | grep -i kvm
  'disabled by bios' means virtualization is off in firmware: enable VT-x/SVM in BIOS/UEFI."
  fi
fi

if [ -e "$KVM_DEV" ]; then
  if [ -r "$KVM_DEV" ] && [ -w "$KVM_DEV" ]; then
    ok "you can use $KVM_DEV"
  else
    as_root "add $USER to the kvm group (permanent, after next login)" usermod -aG kvm "$USER"
    as_root "grant access now, without logging out" setfacl -m "u:$USER:rw" "$KVM_DEV" \
      && ok "access granted (log out and back in at some point to make the group change stick)"
    [ $CHECK -eq 1 ] || { [ -r "$KVM_DEV" ] && [ -w "$KVM_DEV" ]; } || die "still no access to $KVM_DEV"
  fi
fi

# ------------------------------------------------------------------ 3. host packages
step "Host packages"
declare -A PKG_FOR=( [qemu-system-x86_64]=qemu-system-x86 [qemu-img]=qemu-utils [jq]=jq
                     [sqlite3]=sqlite3 [pdftotext]=poppler-utils [git]=git [curl]=curl [setfacl]=acl )
MISSING_PKGS=()
for cmd in "${!PKG_FOR[@]}"; do command -v "$cmd" >/dev/null || MISSING_PKGS+=("${PKG_FOR[$cmd]}"); done
ls /usr/share/OVMF/OVMF_CODE*.fd >/dev/null 2>&1 || MISSING_PKGS+=(ovmf)
if [ ${#MISSING_PKGS[@]} -eq 0 ]; then
  ok "qemu, ovmf, jq, sqlite3, poppler-utils, git, curl, acl"
elif command -v apt-get >/dev/null; then
  mapfile -t MISSING_PKGS < <(printf '%s\n' "${MISSING_PKGS[@]}" | sort -u)
  as_root "install ${MISSING_PKGS[*]}" sh -c "apt-get update -q && apt-get install -y -q ${MISSING_PKGS[*]}" \
    && ok "installed ${MISSING_PKGS[*]}" || { [ $CHECK -eq 1 ] || die "host packages missing"; }
else
  die "missing packages (Debian/Ubuntu names): ${MISSING_PKGS[*]}
  This script installs with apt; on other distros install the equivalents, then re-run."
fi

# ------------------------------------------------------------------ 4. Lima
step "Lima $LIMA_VERSION (in ~/.local, no sudo)"
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) export PATH="$HOME/.local/bin:$PATH"
  warn "~/.local/bin is not on your PATH; add to your shell rc:  export PATH=\"\$HOME/.local/bin:\$PATH\"" ;; esac
if command -v limactl >/dev/null && [ "$(limactl --version | awk '{print $3}')" = "$LIMA_VERSION" ]; then
  ok "limactl $LIMA_VERSION"
elif [ $CHECK -eq 1 ]; then
  todo "install Lima $LIMA_VERSION to ~/.local"
else
  tgz=$(mktemp --suffix=.tgz)
  curl -fsSL -o "$tgz" "https://github.com/lima-vm/lima/releases/download/v$LIMA_VERSION/lima-$LIMA_VERSION-Linux-x86_64.tar.gz" \
    || die "download of Lima failed"
  echo "$LIMA_SHA256  $tgz" | sha256sum -c --quiet - || { rm -f "$tgz"; die "Lima checksum mismatch"; }
  mkdir -p "$HOME/.local" && tar -C "$HOME/.local" -xzf "$tgz" && rm -f "$tgz"
  ok "installed limactl $(limactl --version | awk '{print $3}')"
fi

[ $CHECK -eq 1 ] && {
  echo; [ $PENDING -eq 1 ] && echo "${Y}--check: the items marked todo would be done by ./setup${N}" \
                           || echo "${G}--check: host is ready; ./setup would build source, VM, corpus and site${N}"
  exit 0; }

# ------------------------------------------------------------------ 5. source
step "Pinned upstream source (src/)"
tools/fetch-src | grep -E '^ok|FAIL' | sed 's/^/  /' || die "tools/fetch-src failed"

# ------------------------------------------------------------------ 6. lab VM
step "Lab VM"
vm_status=$(limactl list --format '{{.Name}} {{.Status}}' 2>/dev/null | awk '$1=="bud"{print $2}')
if [ $RESET_VM -eq 1 ] || [ -z "$vm_status" ]; then
  echo "  building the VM from scratch (~10 min; log: vm/.reset.log)"
  vm/reset > vm/.reset.log 2>&1 || die "vm/reset failed; see vm/.reset.log"
  ok "VM built and verified"
else
  mounted=$(limactl list bud --json 2>/dev/null | python3 -I -c 'import json,sys; print(json.loads(sys.stdin.readline())["config"]["mounts"][0]["location"])' 2>/dev/null)
  [ "$mounted" = "$REPO" ] || die "VM 'bud' mounts $mounted at /course, not this repo ($REPO).
  Labs would run the other copy. Rebuild it for this repo: ./setup --reset-vm"
  ok "VM mounts this repo at /course"
  [ "$vm_status" = Running ] || { limactl start bud >/dev/null 2>&1 || die "limactl start bud failed"; }
  if limactl shell bud bash /course/vm/verify >/dev/null 2>&1; then ok "existing VM 'bud' verifies against pins"
  else die "existing VM 'bud' does not match the pins. Rebuild it: ./setup --reset-vm"; fi
fi

# ------------------------------------------------------------------ 7. corpus + index
step "Accuracy corpus"
out=$(tools/fetch-corpus 2>&1); echo "$out" | grep -E '^(ok|FAIL|DRIFT|chunks)' | sed 's/^/  /'
nonpdf=$(echo "$out" | grep '^FAIL' | grep -v 'corpus/private/books' || true)
[ -z "$nonpdf" ] || die "corpus build failed (see FAIL lines above)"
if echo "$out" | grep -q '^FAIL'; then
  warn "books missing: copy your own PDFs into corpus/private/books/ (names in corpus/manifest.toml), then run tools/fetch-corpus"
fi
tools/index | sed 's/^/  /'

# ------------------------------------------------------------------ 8. site
step "Site dependencies"
if (cd site && npm ci --no-audit --no-fund --loglevel=error) >/dev/null; then ok "site/node_modules (pinned by package-lock.json)"
else die "npm ci failed in site/"; fi

# ------------------------------------------------------------------ 9. self-test
step "Self-test"
tools/check-links | tail -1 | sed 's/^/  /'
tools/lab all | sed 's/^/  /' || die "lab self-test failed"

echo
echo "${G}${B}setup complete.${N}"
for w in "${WARNINGS[@]}"; do echo "  ${Y}warn${N}  $w"; done
cat <<EOF

  Read the course:   cd site && npm run dev      -> http://localhost:4321
  Use the lab VM:    limactl shell bud           (repo at /course)
  Run experiments:   tools/lab all
  Free 3 GiB RAM:    limactl stop bud            (./setup brings it back)
EOF
