---
// A deterministic graph (call graph, package deps, sequence from a trace) rendered to SVG by
// tools/graphs/ and committed under site/public/graphs/. `from` records the exact command that
// produced it, so anyone can regenerate and diff it. LLM-drawn maps are never used here.
//   <Graph svg="graphs/runc-init.svg" caption="runc init call path" from="tools/graphs/callgraph runc ..." />
interface Props { svg: string; caption: string; from: string }
const { svg, caption, from } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<figure class="graph">
  <img src={`${base}/${svg.replace(/^\//, '')}`} alt={caption} loading="lazy" />
  <figcaption>{caption}<br /><span class="graph-from">generated by <code>{from}</code></span></figcaption>
</figure>
