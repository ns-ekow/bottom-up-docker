#!/usr/bin/env bash
# Deterministic package-import graph of a pinned Go repo, computed by `go list` and drawn by
# Graphviz, both inside the lab VM. Same inputs -> byte-identical SVG.
#
#   tools/graphs/godeps <repo> <package-pattern> <name>
#   tools/graphs/godeps runc ./libcontainer/... runc-libcontainer
#     -> site/public/graphs/runc-libcontainer.svg (+ .dot alongside, for diffing)
#
# Only edges between packages of the repo's own module are drawn (stdlib/vendor omitted).
set -euo pipefail
# Lima's guest agent socket exists only inside a Lima VM: this script drives the VM from outside.
if [ -S /run/lima-guestagent.sock ]; then
  echo "You're inside the lab VM. tools/graphs/godeps runs on your own computer: type 'exit' to leave the VM, then run it again." >&2
  exit 2
fi
[ $# -eq 3 ] || { sed -n '2,10p' "$0"; exit 2; }
repo=$1 pattern=$2 name=$3
REPO="$(cd "$(dirname "$0")/../.." && pwd)"
[ -d "$REPO/src/$repo" ] || { echo "src/$repo missing: run tools/fetch-src" >&2; exit 1; }
mkdir -p "$REPO/site/public/graphs"

limactl shell --workdir "/course/src/$repo" bud bash -s -- "$pattern" "$name" <<'VM'
set -euo pipefail
export PATH=/usr/local/go/bin:$PATH GOTOOLCHAIN=local GOFLAGS=-mod=mod
[ -d vendor ] && export GOFLAGS=-mod=vendor
pattern=$1 name=$2
mod=$(go list -m)
out=/course/site/public/graphs/$name
{
  echo "digraph G {"
  echo '  rankdir=LR; node [shape=box, style="rounded,filled", fillcolor="#eef2ff", fontname="monospace", fontsize=10]; edge [color="#64748b"];'
  echo "  label=\"$mod  $pattern  (go list, pinned commit $(git rev-parse --short=12 HEAD))\"; labelloc=t; fontname=monospace; fontsize=10;"
  go list -f '{{.ImportPath}}{{range .Imports}} {{.}}{{end}}' "$pattern" \
    | awk -v m="$mod/" '{ for (i = 2; i <= NF; i++) if (index($i, m) == 1) printf "  \"%s\" -> \"%s\";\n", substr($1, length(m)+1), substr($i, length(m)+1) }' \
    | sort -u
  echo "}"
} > "$out.dot"
dot -Tsvg "$out.dot" | sed '/^<!-- Generated by graphviz/,/-->/d' > "$out.svg"
echo "wrote site/public/graphs/$name.svg ($(grep -c -- '->' "$out.dot") edges)"
VM
