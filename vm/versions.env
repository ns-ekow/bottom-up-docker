# Single source of truth for everything installed in the lab VM. Mirrors ../pins.lock.
# Every download is verified against the sha256 recorded here; provisioning aborts on mismatch.

GO_VERSION=1.27.4
GO_SHA256=7226736c2339719cda28fbf3a54d71aa63bcefe376e98cef00034268dab24840

# Docker static bundle supplies dockerd, docker CLI, docker-proxy, docker-init.
# Docker publishes no checksum for static bundles; this sha256 was recorded on first download (2026-11-17).
DOCKER_VERSION=29.10.0
DOCKER_SHA256=7c1ebadc65c716cdc6d35fc78759ed0e4317debf43c21dd12f066f2006999def

# containerd and runc are installed from their own releases, so the versions are exactly the ones
# docker-v29.10.0 builds against, not whatever the static bundle happens to contain.
CONTAINERD_VERSION=2.4.2
CONTAINERD_SHA256=35880c1dd4627e8ce56526bfabb39c144e83458ffdb197ce6f05d17d94d7d91e

RUNC_VERSION=1.5.3
RUNC_SHA256=50dcc0b257d724fe07f3852c2dda52340223f038227c7572644eec870741223e

BUILDKIT_VERSION=0.35.0
BUILDKIT_SHA256=37b3befbed28fb72a44d72bf42362c268610386c42feafa27cb45ee0b531369c

BUILDX_VERSION=0.39.0
BUILDX_SHA256=5fb31a097304fbf6dd4038649a0decf32c2b9510e4047acd7d68b9d700c46194

# Installed with `go install`; integrity is verified by Go's checksum database.
DELVE_VERSION=1.27.2

# Host-side: Lima (installed to ~/.local by ./setup). Checksum from the release's SHA256SUMS.
LIMA_VERSION=2.3.0
LIMA_SHA256=cc8ba97f1c801b899f7c9eda9919dfc4ce4fa2c140c53e5add15aa2d0a1936f9

# Host-side minimums checked by ./setup
NODE_MIN=22.23.4
PYTHON_MIN=3.11
